metry x="385" y="470" width="125" height="60" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;inventory&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;10% slow · 5% HTTP 500&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="470" width="125" height="60" as="geometry"/></mxCell><mxCell id="ns_bey" value="namespace: beyla" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E9E9E;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="540" width="510" height="110" as="geometry"/></mxCell><mxCell id="beyla" value="&lt;b&gt;Grafana Beyla (DaemonSet)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;eBPF auto-instrumentation → RED metrics + traces&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715" y="575" width="480" height="60" as="geometry"/></mxCell><mxCell id="kernel" value="Linux kernel · eBPF lives here" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1180" height="255" as="geometry"/></mxCell><mxCell id="k_tc" value="&lt;b&gt;tc hooks on every pod&#x27;s network interface&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Cilium: forward · enforce policy · emit flow events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="360" height="75" as="geometry"/></mxCell><mxCell id="k_probe" value="&lt;b&gt;kprobes / uprobes on socket + HTTP paths&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Beyla: time each reques